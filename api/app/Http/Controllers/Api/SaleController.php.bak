<?php

namespace App\Http\Controllers\Api;

use App\Http\Controllers\Controller;
use App\Models\Sale;
use App\Models\Product;
use App\Models\StockMovement;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Validator;

class SaleController extends Controller
{
    /**
     * Get all sales with filters
     *
     * Filters: status, start_date, end_date, user_id
     * Example: /api/sales?status=completed&start_date=2026-01-01
     */
    public function index(Request $request)
    {
        $query = Sale::with(['user', 'customer', 'items.product', 'payments']);

        // Filter by status
        if ($request->has('status')) {
            $query->where('status', $request->status);
        }

        // Filter by date range
        if ($request->has('start_date')) {
            $query->whereDate('created_at', '>=', $request->start_date);
        }

        if ($request->has('end_date')) {
            $query->whereDate('created_at', '<=', $request->end_date);
        }

        // Filter by user (cashier)
        if ($request->has('user_id')) {
            $query->where('user_id', $request->user_id);
        }

        // Filter by customer
        if ($request->has('customer_id')) {
            $query->where('customer_id', $request->customer_id);
        }

        // Sort by newest first
        $query->orderBy('created_at', 'desc');

        $perPage = $request->get('per_page', 15);
        $sales = $query->paginate($perPage);

        return response()->json([
            'success' => true,
            'data' => $sales
        ]);
    }

    /**
     * Get single sale with full details
     */
    public function show($id)
    {
        $sale = Sale::with(['user', 'items.product', 'payments'])->find($id);

        if (!$sale) {
            return response()->json([
                'success' => false,
                'message' => 'Sale not found'
            ], 404);
        }

        return response()->json([
            'success' => true,
            'data' => $sale
        ]);
    }

    /**
     * Create new sale (Checkout process)
     *
     * This is the main checkout endpoint that:
     * 1. Validates all items and stock
     * 2. Calculates totals (subtotal, tax, discount, total)
     * 3. Deducts inventory
     * 4. Records stock movements
     * 5. Creates sale with items
     * 6. Records payments
     * 7. Generates invoice number
     */
    public function store(Request $request)
    {
        // Validation
        $validator = Validator::make($request->all(), [
            'customer_id' => 'nullable|exists:customers,id',

            'items' => 'required|array|min:1',
            'items.*.product_id' => 'required|exists:products,id',
            'items.*.quantity' => 'required|integer|min:1',
            'items.*.unit_price' => 'required|numeric|min:0',

            'tax_percentage' => 'nullable|numeric|min:0|max:100',
            'discount_type' => 'nullable|in:fixed,percentage',
            'discount_value' => 'nullable|numeric|min:0',

            'payments' => 'required|array|min:1',
            'payments.*.payment_method' => 'required|in:cash,card,e-wallet',
            'payments.*.amount' => 'required|numeric|min:0',
            'payments.*.reference_number' => 'nullable|string|max:255',
        ]);

        if ($validator->fails()) {
            return response()->json([
                'success' => false,
                'message' => 'Validation failed',
                'errors' => $validator->errors()
            ], 422);
        }

        DB::beginTransaction();

        try {
            // Step 1: Validate stock availability for all items
            foreach ($request->items as $item) {
                $product = Product::with('inventory')->find($item['product_id']);

                if (!$product) {
                    throw new \Exception("Product ID {$item['product_id']} not found");
                }

                if (!$product->is_active) {
                    throw new \Exception("Product '{$product->name}' is not active");
                }

                if (!$product->inventory) {
                    throw new \Exception("No inventory record for '{$product->name}'");
                }

                if ($product->inventory->quantity < $item['quantity']) {
                    throw new \Exception(
                        "Insufficient stock for '{$product->name}'. " .
                        "Available: {$product->inventory->quantity}, Requested: {$item['quantity']}"
                    );
                }
            }

            // Step 2: Calculate totals
            $subtotal = 0;
            foreach ($request->items as $item) {
                $subtotal += $item['quantity'] * $item['unit_price'];
            }

            $taxPercentage = $request->get('tax_percentage', 0);
            $taxAmount = ($subtotal * $taxPercentage) / 100;

            $discountType = $request->get('discount_type', 'fixed');
            $discountValue = $request->get('discount_value', 0);

            if ($discountType === 'percentage') {
                $discountAmount = ($subtotal * $discountValue) / 100;
            } else {
                $discountAmount = $discountValue;
            }

            $totalAmount = $subtotal + $taxAmount - $discountAmount;

            // Step 3: Validate payment amount
            $totalPayment = array_sum(array_column($request->payments, 'amount'));

            if (abs($totalPayment - $totalAmount) > 0.01) { // Allow 1 cent difference for rounding
                throw new \Exception(
                    "Payment mismatch. Total: {$totalAmount}, Paid: {$totalPayment}"
                );
            }

            // Step 4: Generate invoice number (Format: INV-YYYY-NNNN)
            $year = date('Y');
            $lastSale = Sale::whereYear('created_at', $year)
                ->orderBy('id', 'desc')
                ->first();

            if ($lastSale && preg_match('/INV-\d{4}-(\d+)/', $lastSale->invoice_number, $matches)) {
                $nextNumber = intval($matches[1]) + 1;
            } else {
                $nextNumber = 1;
            }

            $invoiceNumber = sprintf('INV-%s-%04d', $year, $nextNumber);

            // Step 5: Create sale
            $sale = Sale::create([
                'invoice_number' => $invoiceNumber,
                'user_id' => auth()->id(),
                'customer_id' => $request->customer_id,
                'subtotal' => $subtotal,
                'tax_percentage' => $taxPercentage,
                'tax_amount' => $taxAmount,
                'discount_type' => $discountType,
                'discount_value' => $discountValue,
                'discount_amount' => $discountAmount,
                'total_amount' => $totalAmount,
                'status' => 'completed'
            ]);

            // Step 6: Create sale items and deduct inventory
            foreach ($request->items as $item) {
                // Create sale item
                $sale->items()->create([
                    'product_id' => $item['product_id'],
                    'quantity' => $item['quantity'],
                    'unit_price' => $item['unit_price'],
                    'subtotal' => $item['quantity'] * $item['unit_price']
                ]);

                // Deduct inventory
                $product = Product::find($item['product_id']);
                $product->inventory->decrement('quantity', $item['quantity']);

                // Record stock movement
                StockMovement::create([
                    'product_id' => $item['product_id'],
                    'type' => 'out',
                    'quantity' => $item['quantity'],
                    'reference' => $invoiceNumber,
                    'notes' => 'Sale transaction',
                    'user_id' => auth()->id()
                ]);
            }

            // Step 7: Record payments
            foreach ($request->payments as $payment) {
                $sale->payments()->create([
                    'payment_method' => $payment['payment_method'],
                    'amount' => $payment['amount'],
                    'reference_number' => $payment['reference_number'] ?? null
                ]);
            }

            DB::commit();

            // Award loyalty points if customer exists (1 point per $10 spent)
            if ($request->customer_id) {
                $customer = \App\Models\Customer::find($request->customer_id);
                if ($customer) {
                    $points = floor($totalAmount / 10);
                    $customer->addLoyaltyPoints($points);
                }
            }

            // Load relationships for response
            $sale->load(['user', 'customer', 'items.product', 'payments']);

            return response()->json([
                'success' => true,
                'message' => 'Sale completed successfully',
                'data' => $sale
            ], 201);

        } catch (\Exception $e) {
            DB::rollback();

            return response()->json([
                'success' => false,
                'message' => 'Failed to process sale',
                'error' => $e->getMessage()
            ], 500);
        }
    }

    /**
     * Update sale status
     *
     * Only allows: completed -> void
     * Cannot void sales from previous days (configurable)
     */
    public function updateStatus(Request $request, $id)
    {
        // Only admin can update status
        if (!auth()->user()->isAdmin()) {
            return response()->json([
                'success' => false,
                'message' => 'Unauthorized. Only admins can update sale status.'
            ], 403);
        }

        $validator = Validator::make($request->all(), [
            'status' => 'required|in:completed,void',
            'reason' => 'required_if:status,void|string|max:500'
        ]);

        if ($validator->fails()) {
            return response()->json([
                'success' => false,
                'message' => 'Validation failed',
                'errors' => $validator->errors()
            ], 422);
        }

        $sale = Sale::find($id);

        if (!$sale) {
            return response()->json([
                'success' => false,
                'message' => 'Sale not found'
            ], 404);
        }

        if ($sale->status === 'void') {
            return response()->json([
                'success' => false,
                'message' => 'Sale is already void'
            ], 400);
        }

        // Prevent voiding sales from previous days (business rule)
        if ($request->status === 'void' && !$sale->created_at->isToday()) {
            return response()->json([
                'success' => false,
                'message' => 'Cannot void sales from previous days'
            ], 400);
        }

        DB::beginTransaction();

        try {
            if ($request->status === 'void') {
                // Restore inventory when voiding sale
                foreach ($sale->items as $item) {
                    $item->product->inventory->increment('quantity', $item->quantity);

                    // Record stock movement
                    StockMovement::create([
                        'product_id' => $item->product_id,
                        'type' => 'in',
                        'quantity' => $item->quantity,
                        'reference' => $sale->invoice_number . ' (VOID)',
                        'notes' => 'Sale voided: ' . $request->reason,
                        'user_id' => auth()->id()
                    ]);
                }
            }

            $sale->update(['status' => $request->status]);

            DB::commit();

            return response()->json([
                'success' => true,
                'message' => 'Sale status updated successfully',
                'data' => $sale
            ]);

        } catch (\Exception $e) {
            DB::rollback();

            return response()->json([
                'success' => false,
                'message' => 'Failed to update sale status',
                'error' => $e->getMessage()
            ], 500);
        }
    }

    /**
     * Get today's sales summary
     */
    public function todaySummary()
    {
        $today = now()->startOfDay();

        $sales = Sale::whereDate('created_at', $today)
            ->where('status', 'completed')
            ->get();

        $totalSales = $sales->count();
        $totalRevenue = $sales->sum('total_amount');
        $totalTax = $sales->sum('tax_amount');
        $totalDiscount = $sales->sum('discount_amount');

        return response()->json([
            'success' => true,
            'data' => [
                'date' => $today->format('Y-m-d'),
                'total_sales' => $totalSales,
                'total_revenue' => round($totalRevenue, 2),
                'total_tax' => round($totalTax, 2),
                'total_discount' => round($totalDiscount, 2),
                'sales' => $sales
            ]
        ]);
    }

    /**
     * Get sales statistics
     *
     * Query params: period (today, week, month, year)
     */
    public function statistics(Request $request)
    {
        $period = $request->get('period', 'today');

        $query = Sale::where('status', 'completed');

        switch ($period) {
            case 'today':
                $query->whereDate('created_at', now());
                break;
            case 'week':
                $query->whereBetween('created_at', [now()->startOfWeek(), now()->endOfWeek()]);
                break;
            case 'month':
                $query->whereMonth('created_at', now()->month)
                    ->whereYear('created_at', now()->year);
                break;
            case 'year':
                $query->whereYear('created_at', now()->year);
                break;
        }

        $sales = $query->get();

        $totalSales = $sales->count();
        $totalRevenue = $sales->sum('total_amount');
        $totalTax = $sales->sum('tax_amount');
        $totalDiscount = $sales->sum('discount_amount');
        $averageSale = $totalSales > 0 ? $totalRevenue / $totalSales : 0;

        // Top selling products
        $topProducts = DB::table('sale_items')
            ->join('products', 'sale_items.product_id', '=', 'products.id')
            ->join('sales', 'sale_items.sale_id', '=', 'sales.id')
            ->where('sales.status', 'completed')
            ->when($period === 'today', function ($query) {
                return $query->whereDate('sales.created_at', now());
            })
            ->when($period === 'week', function ($query) {
                return $query->whereBetween('sales.created_at', [now()->startOfWeek(), now()->endOfWeek()]);
            })
            ->when($period === 'month', function ($query) {
                return $query->whereMonth('sales.created_at', now()->month)
                    ->whereYear('sales.created_at', now()->year);
            })
            ->when($period === 'year', function ($query) {
                return $query->whereYear('sales.created_at', now()->year);
            })
            ->select(
                'products.id',
                'products.name',
                DB::raw('SUM(sale_items.quantity) as total_quantity'),
                DB::raw('SUM(sale_items.subtotal) as total_revenue')
            )
            ->groupBy('products.id', 'products.name')
            ->orderBy('total_quantity', 'desc')
            ->limit(10)
            ->get();

        return response()->json([
            'success' => true,
            'data' => [
                'period' => $period,
                'total_sales' => $totalSales,
                'total_revenue' => round($totalRevenue, 2),
                'total_tax' => round($totalTax, 2),
                'total_discount' => round($totalDiscount, 2),
                'average_sale' => round($averageSale, 2),
                'top_products' => $topProducts
            ]
        ]);
    }
}
