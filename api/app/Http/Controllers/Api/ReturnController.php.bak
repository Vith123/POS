<?php

namespace App\Http\Controllers\Api;

use App\Http\Controllers\Controller;
use App\Models\ProductReturn;
use App\Models\Sale;
use App\Models\Product;
use App\Models\StockMovement;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Validator;

class ReturnController extends Controller
{
    /**
     * Get all returns with filters
     */
    public function index(Request $request)
    {
        $query = ProductReturn::with(['sale', 'product', 'user']);

        // Filter by status
        if ($request->has('status')) {
            $query->where('status', $request->status);
        }

        // Filter by date range
        if ($request->has('start_date')) {
            $query->whereDate('created_at', '>=', $request->start_date);
        }

        if ($request->has('end_date')) {
            $query->whereDate('created_at', '<=', $request->end_date);
        }

        // Filter by product
        if ($request->has('product_id')) {
            $query->where('product_id', $request->product_id);
        }

        // Sort by newest first
        $query->orderBy('created_at', 'desc');

        $perPage = $request->get('per_page', 15);
        $returns = $query->paginate($perPage);

        return response()->json([
            'success' => true,
            'data' => $returns
        ]);
    }

    /**
     * Get single return
     */
    public function show($id)
    {
        $return = ProductReturn::with(['sale.items.product', 'product', 'user'])->find($id);

        if (!$return) {
            return response()->json([
                'success' => false,
                'message' => 'Return not found'
            ], 404);
        }

        return response()->json([
            'success' => true,
            'data' => $return
        ]);
    }

    /**
     * Create new return request
     */
    public function store(Request $request)
    {
        $validator = Validator::make($request->all(), [
            'sale_id' => 'required|exists:sales,id',
            'product_id' => 'required|exists:products,id',
            'quantity' => 'required|integer|min:1',
            'refund_amount' => 'required|numeric|min:0',
            'reason' => 'required|in:defective,wrong_item,customer_request,damaged,other',
            'notes' => 'nullable|string'
        ]);

        if ($validator->fails()) {
            return response()->json([
                'success' => false,
                'message' => 'Validation failed',
                'errors' => $validator->errors()
            ], 422);
        }

        DB::beginTransaction();

        try {
            // Validate sale exists and is completed
            $sale = Sale::with('items')->find($request->sale_id);

            if (!$sale) {
                throw new \Exception('Sale not found');
            }

            if ($sale->status === 'void') {
                throw new \Exception('Cannot return items from void sale');
            }

            // Check if product was in this sale
            $saleItem = $sale->items()->where('product_id', $request->product_id)->first();

            if (!$saleItem) {
                throw new \Exception('Product not found in this sale');
            }

            // Check if quantity is valid
            $alreadyReturned = ProductReturn::where('sale_id', $request->sale_id)
                ->where('product_id', $request->product_id)
                ->where('status', '!=', 'rejected')
                ->sum('quantity');

            if (($alreadyReturned + $request->quantity) > $saleItem->quantity) {
                throw new \Exception(
                    "Cannot return more than purchased. " .
                    "Purchased: {$saleItem->quantity}, Already returned: {$alreadyReturned}"
                );
            }

            // Generate return number (Format: RET-YYYY-NNNN)
            $year = date('Y');
            $lastReturn = ProductReturn::whereYear('created_at', $year)
                ->orderBy('id', 'desc')
                ->first();

            if ($lastReturn && preg_match('/RET-\d{4}-(\d+)/', $lastReturn->return_number, $matches)) {
                $nextNumber = intval($matches[1]) + 1;
            } else {
                $nextNumber = 1;
            }

            $returnNumber = sprintf('RET-%s-%04d', $year, $nextNumber);

            // Create return
            $return = ProductReturn::create([
                'return_number' => $returnNumber,
                'sale_id' => $request->sale_id,
                'product_id' => $request->product_id,
                'user_id' => auth()->id(),
                'quantity' => $request->quantity,
                'refund_amount' => $request->refund_amount,
                'reason' => $request->reason,
                'notes' => $request->notes,
                'status' => 'pending'
            ]);

            DB::commit();

            $return->load(['sale', 'product', 'user']);

            return response()->json([
                'success' => true,
                'message' => 'Return request created successfully',
                'data' => $return
            ], 201);

        } catch (\Exception $e) {
            DB::rollback();

            return response()->json([
                'success' => false,
                'message' => 'Failed to create return request',
                'error' => $e->getMessage()
            ], 500);
        }
    }

    /**
     * Approve or reject return
     */
    public function updateStatus(Request $request, $id)
    {
        // Only admin can approve/reject returns
        if (!auth()->user()->isAdmin()) {
            return response()->json([
                'success' => false,
                'message' => 'Unauthorized. Only admins can approve/reject returns.'
            ], 403);
        }

        $validator = Validator::make($request->all(), [
            'status' => 'required|in:approved,rejected',
            'notes' => 'nullable|string'
        ]);

        if ($validator->fails()) {
            return response()->json([
                'success' => false,
                'message' => 'Validation failed',
                'errors' => $validator->errors()
            ], 422);
        }

        $return = ProductReturn::find($id);

        if (!$return) {
            return response()->json([
                'success' => false,
                'message' => 'Return not found'
            ], 404);
        }

        if ($return->status !== 'pending') {
            return response()->json([
                'success' => false,
                'message' => 'Return has already been processed'
            ], 400);
        }

        DB::beginTransaction();

        try {
            if ($request->status === 'approved') {
                // Restore inventory
                $product = Product::find($return->product_id);
                $product->inventory->increment('quantity', $return->quantity);

                // Record stock movement
                StockMovement::create([
                    'product_id' => $return->product_id,
                    'type' => 'in',
                    'quantity' => $return->quantity,
                    'reference' => $return->return_number,
                    'notes' => 'Product return approved: ' . $return->reason,
                    'user_id' => auth()->id()
                ]);
            }

            // Update return status
            $return->update([
                'status' => $request->status,
                'notes' => $request->notes ? $return->notes . "\n\nAdmin: " . $request->notes : $return->notes
            ]);

            DB::commit();

            $return->load(['sale', 'product', 'user']);

            return response()->json([
                'success' => true,
                'message' => 'Return ' . $request->status . ' successfully',
                'data' => $return
            ]);

        } catch (\Exception $e) {
            DB::rollback();

            return response()->json([
                'success' => false,
                'message' => 'Failed to update return status',
                'error' => $e->getMessage()
            ], 500);
        }
    }

    /**
     * Get pending returns
     */
    public function pending()
    {
        $returns = ProductReturn::pending()
            ->with(['sale', 'product', 'user'])
            ->orderBy('created_at', 'asc')
            ->get();

        return response()->json([
            'success' => true,
            'count' => $returns->count(),
            'data' => $returns
        ]);
    }

    /**
     * Get return statistics
     */
    public function statistics(Request $request)
    {
        $period = $request->get('period', 'month');

        $query = ProductReturn::query();

        switch ($period) {
            case 'today':
                $query->whereDate('created_at', now());
                break;
            case 'week':
                $query->whereBetween('created_at', [now()->startOfWeek(), now()->endOfWeek()]);
                break;
            case 'month':
                $query->whereMonth('created_at', now()->month)
                    ->whereYear('created_at', now()->year);
                break;
            case 'year':
                $query->whereYear('created_at', now()->year);
                break;
        }

        $returns = $query->get();

        $totalReturns = $returns->count();
        $totalRefunded = $returns->where('status', 'approved')->sum('refund_amount');
        $pendingCount = $returns->where('status', 'pending')->count();
        $approvedCount = $returns->where('status', 'approved')->count();
        $rejectedCount = $returns->where('status', 'rejected')->count();

        // Most returned products
        $topReturns = $returns->where('status', 'approved')
            ->groupBy('product_id')
            ->map(function ($items) {
                return [
                    'product_id' => $items->first()->product_id,
                    'product_name' => $items->first()->product->name,
                    'total_quantity' => $items->sum('quantity'),
                    'total_refunded' => $items->sum('refund_amount')
                ];
            })
            ->sortByDesc('total_quantity')
            ->take(10)
            ->values();

        // Return reasons breakdown
        $reasonsBreakdown = $returns->groupBy('reason')
            ->map(function ($items, $reason) {
                return [
                    'reason' => $reason,
                    'count' => $items->count(),
                    'total_refunded' => $items->where('status', 'approved')->sum('refund_amount')
                ];
            })
            ->values();

        return response()->json([
            'success' => true,
            'data' => [
                'period' => $period,
                'total_returns' => $totalReturns,
                'total_refunded' => round($totalRefunded, 2),
                'pending_count' => $pendingCount,
                'approved_count' => $approvedCount,
                'rejected_count' => $rejectedCount,
                'top_returned_products' => $topReturns,
                'reasons_breakdown' => $reasonsBreakdown
            ]
        ]);
    }
}
